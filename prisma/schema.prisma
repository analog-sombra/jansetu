// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum ROLE {
  SYSTEM
  ADMIN

  MLA
  MLA_SECRETARY

  MLA_PA
  CAMP_HEAD

  OFFICER

  CAMP_DEO
  CAMP_FIELD_OFFICER

  CITIZEN
}

enum COMPLAINTSTATUS {
  PENDING
  IN_PROGRESS
  WORK_IN_PROGRESS
  QUERY_RAISED
  RESOLVED
  REJECTED
  CLOSED
  ESCALATED
  AUTO_CLOSED
}

enum ASIGNMENTSTATUS {
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  QUERY
  REJECTED
  ESCALATED
}

enum RESPONSETYPE {
  RESOLVED
  QUERY
  REJECTED
  WORK_IN_PROGESS
}

enum MEDIATYPE {
  IMAGE
  VIDEO
  DOCUMENT
}

enum NOTIFICATIONCHANNEL {
  SMS
  EMAIL
  SYSTEM
}

enum NOTIFICATIONSTATUS {
  SENT
  FAILED
}

enum MEETINGTYPE {
  INVITATION
  CONSTITUENCY_VISIT
  DEPARTMENT_VISIT
  CITIZEN_MEET
  PERSONAL_MEET
  PARTY_MEET
  OFFICE_MEET
}

enum MEETINGAPPROVALSTATUS {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

enum MEETINGPRIORITY {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MLAPAMEETINGTYPE {
  INVITATION
  CONSTITUENCY_VISIT
  DEPARTMENT_VISIT
  CITIZEN_MEET
  PERSONAL_MEET
  PARTY_MEET
  OFFICE_MEET
}

enum INVITATIONSUBTYPE {
  MARRIAGE
  BIRTHDAY
  FUNERAL
  OTHER
}

enum WORKSTATUS {
  PROPOSED
  APPROVED
  IN_PROGRESS
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum TASKSTATUS {
  PENDING
  IN_PROGRESS
  COMPLETED
  DELAYED
}

enum WORKMEDIATYPE {
  BEFORE
  PROGRESS
  AFTER
  DOCUMENT
}

model user {
  id                   String                         @id @default(cuid())
  name                 String?
  mobile               String                         @unique
  role                 ROLE                           @default(CITIZEN)
  address              String?
  aadhaar              String?
  voterId              String?
  pan                  String?
  partySupporter       String?
  pollingBooth         String?
  locality             String?
  isPartOfParty        Boolean?                       @default(false)
  firstLoginComplete   Boolean                        @default(false)
  complaints           complaint[]
  complaintsCreated    complaint[]                    @relation("ComplaintCreatedBy")
  auditLogs            audit_log[]
  notifications        notification[]
  meetingsCreated      meeting[]                      @relation("MeetingCreatedBy")
  meetingsAssigned     meeting[]                      @relation("MeetingAssignedTo")
  meetingsCampHead     meeting[]                      @relation("MeetingCampHead")
  reviews              review[]
  disputes             dispute[]
  officerAssignments   complaint_assignment_history[] @relation("OfficerAssignedBy")
  worksCreated         work[]                         @relation("WorkCreatedBy")
  worksApproved        work[]                         @relation("WorkApprovedBy")
  workUpdates          work_update[]                  @relation("WorkUpdateCreatedBy")
  workMedia            work_media[]
  createdAt            DateTime                       @default(now())
  updatedAt            DateTime                       @updatedAt
}

model otp_code {
  id        Int      @id @default(autoincrement())
  mobile    String
  otpHash   String
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([mobile, createdAt])
}

model complaint {
  id                    Int                            @id @default(autoincrement())
  userId                String
  user                  user                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdByUserId       String?
  createdByUser         user?                          @relation("ComplaintCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  categoryId            Int
  category              category                       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subcategoryId         Int
  subcategory           subcategory                    @relation(fields: [subcategoryId], references: [id], onDelete: Restrict)
  description           String                         @db.LongText
  address               String?                        @db.LongText
  status                COMPLAINTSTATUS                @default(PENDING)
  plannedCompletionDate DateTime?
  lat                   Float
  lng                   Float
  area                  String?
  media                 complaint_media[]
  assignments           assignment[]
  officerAssignments    complaint_assignment_history[]
  auditLogs             audit_log[]
  reviews               review[]
  disputes              dispute[]
  affectedCitizensCount Int                            @default(1)
  priority              Int                            @default(10)
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt
  complaintClusters     complaint_cluster[]
  works                 work[]

  @@index([categoryId, subcategoryId, createdAt])
  @@index([lat, lng])
  @@index([createdByUserId, createdAt])
}

model review {
  id          Int       @id @default(autoincrement())
  complaintId Int
  complaint   complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  userId      String
  user        user      @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating      Int
  review      String    @db.LongText
  photoUrl    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([complaintId, userId])
  @@index([complaintId, createdAt])
  @@index([userId, createdAt])
}

model dispute {
  id          Int       @id @default(autoincrement())
  complaintId Int
  complaint   complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  userId      String
  user        user      @relation(fields: [userId], references: [id], onDelete: Cascade)
  remark      String    @db.LongText
  imageUrl    String
  createdAt   DateTime  @default(now())

  @@index([complaintId, createdAt])
  @@index([userId, createdAt])
}

model complaint_cluster {
  id             Int       @id @default(autoincrement())
  complaintId    Int
  complaint      complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  clusterId      String
  departmentName String
  category       String
  subcategory    String?
  areaKey        String?
  latBucket      Int
  lngBucket      Int
  work           work?
  createdAt      DateTime  @default(now())

  @@index([complaintId])
  @@index([clusterId, createdAt])
  @@index([departmentName, createdAt])
  @@index([departmentName, category, subcategory, latBucket, lngBucket])
}

model complaint_media {
  id          Int       @id @default(autoincrement())
  complaintId Int
  complaint   complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  fileUrl     String
  type        MEDIATYPE
  createdAt   DateTime  @default(now())

  @@index([complaintId])
}

model department {
  id         Int         @id @default(autoincrement())
  name       String      @unique
  officers   officer[]
  categories category[]
  works      work[]
  workTasks  work_task[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model officer {
  id           Int                            @id @default(autoincrement())
  name         String
  designation  String
  email        String                         @unique
  phone        String
  departmentId Int
  department   department                     @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  assignments  assignment[]
  history      complaint_assignment_history[]
  workTasks    work_task[]
  createdAt    DateTime                       @default(now())
  updatedAt    DateTime                       @updatedAt

  @@index([departmentId])
}

model assignment {
  id            Int                            @id @default(autoincrement())
  complaintId   Int
  complaint     complaint                      @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  officerId     Int
  officer       officer                        @relation(fields: [officerId], references: [id], onDelete: Restrict)
  status        ASIGNMENTSTATUS                @default(ASSIGNED)
  dueDate       DateTime
  token         String                         @unique
  responses     response[]
  notifications notification[]
  history       complaint_assignment_history[]
  createdAt     DateTime                       @default(now())
  updatedAt     DateTime                       @updatedAt

  @@index([complaintId, officerId])
  @@index([status, dueDate])
}

model complaint_assignment_history {
  id               Int         @id @default(autoincrement())
  complaintId      Int
  complaint        complaint   @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  officerId        Int
  officer          officer     @relation(fields: [officerId], references: [id], onDelete: Restrict)
  assignmentId     Int?
  assignment       assignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  assignedByUserId String?
  assignedByUser   user?       @relation("OfficerAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)
  isCurrent        Boolean     @default(false)
  createdAt        DateTime    @default(now())

  @@index([complaintId, createdAt])
  @@index([complaintId, isCurrent])
  @@index([officerId, createdAt])
}

model response {
  id           Int          @id @default(autoincrement())
  assignmentId Int
  assignment   assignment   @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  type         RESPONSETYPE
  message      String       @db.LongText
  proofUrl     String?
  createdAt    DateTime     @default(now())

  @@index([assignmentId, createdAt])
}

model audit_log {
  id          Int        @id @default(autoincrement())
  actorUserId String?
  actorUser   user?      @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  complaintId Int?
  complaint   complaint? @relation(fields: [complaintId], references: [id], onDelete: SetNull)
  workId      Int?
  work        work?      @relation("WorkAuditLogs", fields: [workId], references: [id], onDelete: SetNull)
  action      String
  meta        Json?
  createdAt   DateTime   @default(now())

  @@index([complaintId, createdAt])
  @@index([workId, createdAt])
}

model notification {
  id           Int                 @id @default(autoincrement())
  userId       String?
  user         user?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  assignmentId Int?
  assignment   assignment?         @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  channel      NOTIFICATIONCHANNEL
  recipient    String
  message      String
  status       NOTIFICATIONSTATUS  @default(SENT)
  error        String?
  createdAt    DateTime            @default(now())

  @@index([userId, createdAt])
  @@index([assignmentId, createdAt])
}

model meeting {
  id                     Int                   @id @default(autoincrement())
  createdByUserId        String
  createdByUser          user                  @relation("MeetingCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  assignedToUserId       String
  assignedToUser         user                  @relation("MeetingAssignedTo", fields: [assignedToUserId], references: [id], onDelete: Cascade)
  campHeadUserId         String?
  campHeadUser           user?                 @relation("MeetingCampHead", fields: [campHeadUserId], references: [id], onDelete: SetNull)
  type                   MEETINGTYPE
  invitationSubtype      INVITATIONSUBTYPE?
  giftToCarry            String?               @db.LongText
  selfDraftedLetter      String?               @db.LongText
  purpose                String                @db.LongText
  meetingDateTime        DateTime?
  meetingPlace           String?
  approvalStatus         MEETINGAPPROVALSTATUS @default(NOT_REQUIRED)
  approvedAt             DateTime?
  rejectedAt             DateTime?
  completedAt            DateTime?
  approvalRemarks        String?               @db.LongText
  preferredDateTime      DateTime?
  priority               MEETINGPRIORITY?
  citizenName            String?
  citizenMobile          String?
  citizenArea            String?
  citizenDetails         String?               @db.LongText
  contactName            String?
  contactMobile          String?
  contactDesignation     String?
  contactDepartment      String?
  partyMeetDetails       String?               @db.LongText
  selectedStaffNames     String?               @db.LongText
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@index([createdByUserId, createdAt])
  @@index([assignedToUserId, createdAt])
  @@index([campHeadUserId])
  @@index([type, approvalStatus])
  @@index([meetingDateTime])
}

model category {
  id            Int           @id @default(autoincrement())
  name          String
  departmentId  Int
  department    department    @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  subcategories subcategory[]
  complaints    complaint[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([departmentId])
}

model subcategory {
  id         Int         @id @default(autoincrement())
  name       String
  categoryId Int
  category   category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  complaints complaint[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model ward {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  constituency String?
  locality_key String?
  works        work[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([constituency])
  @@index([locality_key])
}

model work {
  id                     Int                @id @default(autoincrement())
  title                  String
  description            String             @db.LongText
  departmentId           Int
  department             department         @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  wardId                 Int?
  ward                   ward?              @relation(fields: [wardId], references: [id], onDelete: SetNull)
  status                 WORKSTATUS         @default(PROPOSED)
  priority               Int                @default(50)
  estimated_budget       Decimal?           @db.Decimal(12, 2)
  approved_budget        Decimal?           @db.Decimal(12, 2)
  utilized_budget        Decimal            @default(0) @db.Decimal(12, 2)
  completion_percentage  Int                @default(0)
  start_date             DateTime?
  target_completion_date DateTime?
  actual_completion_date DateTime?
  created_from           String             @default("MANUAL")
  cluster_id             Int?               @unique
  complaint_cluster      complaint_cluster? @relation(fields: [cluster_id], references: [id], onDelete: SetNull)
  complaint_id           Int?
  complaint              complaint?         @relation(fields: [complaint_id], references: [id], onDelete: SetNull)
  remarks                String?            @db.LongText
  approved_by_user_id    String?
  approved_by_user       user?              @relation("WorkApprovedBy", fields: [approved_by_user_id], references: [id], onDelete: SetNull)
  approved_at            DateTime?
  created_by_user_id     String
  created_by_user        user               @relation("WorkCreatedBy", fields: [created_by_user_id], references: [id], onDelete: Cascade)

  tasks      work_task[]
  media      work_media[]
  updates    work_update[]
  audit_logs audit_log[]   @relation("WorkAuditLogs")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId, status])
  @@index([status, target_completion_date])
  @@index([wardId, status])
  @@index([priority, status])
  @@index([created_by_user_id, createdAt])
  @@index([cluster_id])
}

model work_task {
  id                    Int        @id @default(autoincrement())
  work_id               Int
  work                  work       @relation(fields: [work_id], references: [id], onDelete: Cascade)
  title                 String
  description           String?    @db.LongText
  sequence_no           Int
  officer_id            Int?
  officer               officer?   @relation(fields: [officer_id], references: [id], onDelete: SetNull)
  department_id         Int
  department            department @relation(fields: [department_id], references: [id], onDelete: Restrict)
  status                TASKSTATUS @default(PENDING)
  completion_percentage Int        @default(0)
  planned_date          DateTime?
  actual_date           DateTime?
  remarks               String?    @db.LongText

  media work_media[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([work_id, sequence_no])
  @@index([officer_id, status])
  @@index([status, planned_date])
}

model work_media {
  id                  Int           @id @default(autoincrement())
  work_id             Int
  work                work          @relation(fields: [work_id], references: [id], onDelete: Cascade)
  task_id             Int?
  task                work_task?    @relation(fields: [task_id], references: [id], onDelete: SetNull)
  type                WORKMEDIATYPE
  file_path           String
  caption             String?
  uploaded_by_user_id String
  uploaded_by_user    user          @relation(fields: [uploaded_by_user_id], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([work_id, type])
  @@index([task_id])
}

model work_update {
  id                 Int    @id @default(autoincrement())
  work_id            Int
  work               work   @relation(fields: [work_id], references: [id], onDelete: Cascade)
  message            String @db.VarChar(500)
  created_by_user_id String
  created_by_user    user   @relation("WorkUpdateCreatedBy", fields: [created_by_user_id], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([work_id, createdAt])
}
