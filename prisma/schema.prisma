// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum ROLE {
  SYSTEM
  ADMIN

  MLA
  MLA_SECRETARY

  MLA_PA
  CAMP_HEAD

  OFFICER

  CAMP_DEO
  CAMP_FIELD_OFFICER

  CITIZEN
}

enum COMPLAINTSTATUS {
  PENDING
  IN_PROGRESS
  WORK_IN_PROGRESS
  QUERY_RAISED
  RESOLVED
  REJECTED
  CLOSED
  ESCALATED
  AUTO_CLOSED
}

enum ASIGNMENTSTATUS {
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  QUERY
  REJECTED
  ESCALATED
}

enum RESPONSETYPE {
  RESOLVED
  QUERY
  REJECTED
  WORK_IN_PROGESS
}

enum MEDIATYPE {
  IMAGE
  VIDEO
  DOCUMENT
}

enum NOTIFICATIONCHANNEL {
  SMS
  EMAIL
  SYSTEM
}

enum NOTIFICATIONSTATUS {
  SENT
  FAILED
}

enum MEETINGTYPE {
  CONSTITUENCY_VISIT
  DEPARTMENT_VISIT
  CITIZEN_MEET
  PERSONAL_MEET
}

enum MEETINGAPPROVALSTATUS {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

enum MEETINGPRIORITY {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MLAPAMEETINGTYPE {
  INVITATION
  CONSTITUENCY_VISIT
  DEPARTMENT_VISIT
  CITIZEN_MEET
  PERSONAL_MEET
}

enum INVITATIONSUBTYPE {
  MARRIAGE
  BIRTHDAY
  FUNERAL
  OTHER
}

model user {
  id                   String                         @id @default(cuid())
  name                 String?
  mobile               String                         @unique
  role                 ROLE                           @default(CITIZEN)
  address              String?
  aadhaar              String?
  voterId              String?
  pan                  String?
  partySupporter       String?
  pollingBooth         String?
  locality             String?
  isPartOfParty        Boolean?                       @default(false)
  firstLoginComplete   Boolean                        @default(false)
  complaints           complaint[]
  complaintsCreated    complaint[]                    @relation("ComplaintCreatedBy")
  auditLogs            audit_log[]
  notifications        notification[]
  meetingsCreated      meeting[]                      @relation("MeetingCreatedBy")
  meetingsAssigned     meeting[]                      @relation("MeetingAssignedTo")
  reviews              review[]
  disputes             dispute[]
  officerAssignments   complaint_assignment_history[] @relation("OfficerAssignedBy")
  mlaPaMeetingsCreated mla_pa_meeting[]               @relation("MlaPaMeetingCreatedBy")
  mlaPaMeetingsForMla  mla_pa_meeting[]               @relation("MlaPaMeetingMla")
  mlaPaMeetingsForCamp mla_pa_meeting[]               @relation("MlaPaMeetingCampHead")
  createdAt            DateTime                       @default(now())
  updatedAt            DateTime                       @updatedAt
}

model otp_code {
  id        Int      @id @default(autoincrement())
  mobile    String
  otpHash   String
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([mobile, createdAt])
}

model complaint {
  id                    Int                            @id @default(autoincrement())
  userId                String
  user                  user                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdByUserId       String?
  createdByUser         user?                          @relation("ComplaintCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  categoryId            Int
  category              category                       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subcategoryId         Int
  subcategory           subcategory                    @relation(fields: [subcategoryId], references: [id], onDelete: Restrict)
  description           String                         @db.LongText
  status                COMPLAINTSTATUS                @default(PENDING)
  plannedCompletionDate DateTime?
  lat                   Float
  lng                   Float
  area                  String?
  media                 complaint_media[]
  assignments           assignment[]
  officerAssignments    complaint_assignment_history[]
  auditLogs             audit_log[]
  reviews               review[]
  disputes              dispute[]
  affectedCitizensCount Int                            @default(1)
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt
  complaintClusters     complaint_cluster[]

  @@index([categoryId, subcategoryId, createdAt])
  @@index([lat, lng])
  @@index([createdByUserId, createdAt])
}

model review {
  id          Int       @id @default(autoincrement())
  complaintId Int
  complaint   complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  userId      String
  user        user      @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating      Int
  review      String    @db.LongText
  photoUrl    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([complaintId, userId])
  @@index([complaintId, createdAt])
  @@index([userId, createdAt])
}

model dispute {
  id          Int       @id @default(autoincrement())
  complaintId Int
  complaint   complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  userId      String
  user        user      @relation(fields: [userId], references: [id], onDelete: Cascade)
  remark      String    @db.LongText
  imageUrl    String
  createdAt   DateTime  @default(now())

  @@index([complaintId, createdAt])
  @@index([userId, createdAt])
}

model complaint_cluster {
  id             Int       @id @default(autoincrement())
  complaintId    Int
  complaint      complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  clusterId      String
  departmentName String
  category       String
  subcategory    String?
  areaKey        String?
  latBucket      Int
  lngBucket      Int
  createdAt      DateTime  @default(now())

  @@index([complaintId])
  @@index([clusterId, createdAt])
  @@index([departmentName, createdAt])
  @@index([departmentName, category, subcategory, latBucket, lngBucket])
}

model complaint_media {
  id          Int       @id @default(autoincrement())
  complaintId Int
  complaint   complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  fileUrl     String
  type        MEDIATYPE
  createdAt   DateTime  @default(now())

  @@index([complaintId])
}

model department {
  id         Int        @id @default(autoincrement())
  name       String     @unique
  officers   officer[]
  categories category[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model officer {
  id           Int                            @id @default(autoincrement())
  name         String
  designation  String
  email        String                         @unique
  phone        String
  departmentId Int
  department   department                     @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  assignments  assignment[]
  history      complaint_assignment_history[]
  createdAt    DateTime                       @default(now())
  updatedAt    DateTime                       @updatedAt

  @@index([departmentId])
}

model assignment {
  id            Int                            @id @default(autoincrement())
  complaintId   Int
  complaint     complaint                      @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  officerId     Int
  officer       officer                        @relation(fields: [officerId], references: [id], onDelete: Restrict)
  status        ASIGNMENTSTATUS                @default(ASSIGNED)
  dueDate       DateTime
  token         String                         @unique
  responses     response[]
  notifications notification[]
  history       complaint_assignment_history[]
  createdAt     DateTime                       @default(now())
  updatedAt     DateTime                       @updatedAt

  @@index([complaintId, officerId])
  @@index([status, dueDate])
}

model complaint_assignment_history {
  id               Int         @id @default(autoincrement())
  complaintId      Int
  complaint        complaint   @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  officerId        Int
  officer          officer     @relation(fields: [officerId], references: [id], onDelete: Restrict)
  assignmentId     Int?
  assignment       assignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  assignedByUserId String?
  assignedByUser   user?       @relation("OfficerAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)
  isCurrent        Boolean     @default(false)
  createdAt        DateTime    @default(now())

  @@index([complaintId, createdAt])
  @@index([complaintId, isCurrent])
  @@index([officerId, createdAt])
}

model response {
  id           Int          @id @default(autoincrement())
  assignmentId Int
  assignment   assignment   @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  type         RESPONSETYPE
  message      String       @db.LongText
  proofUrl     String?
  createdAt    DateTime     @default(now())

  @@index([assignmentId, createdAt])
}

model audit_log {
  id          Int        @id @default(autoincrement())
  actorUserId String?
  actorUser   user?      @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  complaintId Int?
  complaint   complaint? @relation(fields: [complaintId], references: [id], onDelete: SetNull)
  action      String
  meta        Json?
  createdAt   DateTime   @default(now())

  @@index([complaintId, createdAt])
}

model notification {
  id           Int                 @id @default(autoincrement())
  userId       String?
  user         user?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  assignmentId Int?
  assignment   assignment?         @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  channel      NOTIFICATIONCHANNEL
  recipient    String
  message      String
  status       NOTIFICATIONSTATUS  @default(SENT)
  error        String?
  createdAt    DateTime            @default(now())

  @@index([userId, createdAt])
  @@index([assignmentId, createdAt])
}

model meeting {
  id                 Int                   @id @default(autoincrement())
  createdByUserId    String
  createdByUser      user                  @relation("MeetingCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  assignedToUserId   String
  assignedToUser     user                  @relation("MeetingAssignedTo", fields: [assignedToUserId], references: [id], onDelete: Cascade)
  type               MEETINGTYPE
  purpose            String                @db.LongText
  meetingDateTime    DateTime?
  meetingPlace       String?
  approvalStatus     MEETINGAPPROVALSTATUS @default(NOT_REQUIRED)
  approvedAt         DateTime?
  rejectedAt         DateTime?
  completedAt        DateTime?
  approvalRemarks    String?               @db.LongText
  preferredDateTime  DateTime?
  priority           MEETINGPRIORITY?
  citizenName        String?
  citizenMobile      String?
  citizenArea        String?
  citizenDetails     String?               @db.LongText
  contactName        String?
  contactMobile      String?
  contactDesignation String?
  contactDepartment  String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([createdByUserId, createdAt])
  @@index([assignedToUserId, createdAt])
  @@index([type, approvalStatus])
  @@index([meetingDateTime])
}

model mla_pa_meeting {
  id                     Int                        @id @default(autoincrement())
  createdByUserId        String
  createdByUser          user                       @relation("MlaPaMeetingCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  mlaUserId              String
  mlaUser                user                       @relation("MlaPaMeetingMla", fields: [mlaUserId], references: [id], onDelete: Restrict)
  campHeadUserId         String
  campHeadUser           user                       @relation("MlaPaMeetingCampHead", fields: [campHeadUserId], references: [id], onDelete: Restrict)
  type                   MLAPAMEETINGTYPE
  invitationSubtype      INVITATIONSUBTYPE?
  invitationOtherPurpose String?                    @db.LongText
  purpose                String                     @db.LongText
  scheduledAt            DateTime
  meetingPlace           String
  completedAt            DateTime?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  invitationDetail       mla_pa_invitation_details?

  @@index([createdByUserId, createdAt])
  @@index([mlaUserId, scheduledAt])
  @@index([campHeadUserId, scheduledAt])
  @@index([type, invitationSubtype])
}

model mla_pa_invitation_details {
  id                Int            @id @default(autoincrement())
  meetingId         Int            @unique
  meeting           mla_pa_meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  giftToCarry       String?        @db.LongText
  selfDraftedLetter String?        @db.LongText
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model category {
  id            Int           @id @default(autoincrement())
  name          String
  departmentId  Int
  department    department    @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  subcategories subcategory[]
  complaints    complaint[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([departmentId])
}

model subcategory {
  id         Int         @id @default(autoincrement())
  name       String
  categoryId Int
  category   category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  complaints complaint[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}
