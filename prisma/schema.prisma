// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  SYSTEM
  ADMIN

  MLA
  MLA_SECRETARY

  MLA_PA
  CAMP_HEAD

  OFFICER

  CAMP_DEO
  CAMP_FIELD_OFFICER

  CITIZEN
}

enum ComplaintStatus {
  PENDING
  IN_PROGRESS
  WORK_IN_PROGRESS
  QUERY_RAISED
  RESOLVED
  REJECTED
  CLOSED
  ESCALATED
  AUTO_CLOSED
}

enum AssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  QUERY
  REJECTED
  ESCALATED
}

enum ResponseType {
  RESOLVED
  QUERY
  REJECTED
  WORK_IN_PROGESS
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

enum NotificationChannel {
  SMS
  EMAIL
  SYSTEM
}

enum NotificationStatus {
  SENT
  FAILED
}

enum MeetingType {
  CONSTITUENCY_VISIT
  DEPARTMENT_VISIT
  CITIZEN_MEET
  PERSONAL_MEET
}

enum MeetingApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

enum MeetingPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MlaPaMeetingType {
  INVITATION
  CONSTITUENCY_VISIT
  DEPARTMENT_VISIT
  CITIZEN_MEET
  PERSONAL_MEET
}

enum InvitationSubtype {
  MARRIAGE
  BIRTHDAY
  FUNERAL
  OTHER
}

model User {
  id                   String                              @id @default(cuid())
  name                 String?
  mobile               String                              @unique
  role                 UserRole                            @default(CITIZEN)
  address              String?
  aadhaar              String?
  voterId              String?
  pan                  String?
  partySupporter       String?
  pollingBooth         String?
  locality             String?
  isPartOfParty        Boolean?                            @default(false)
  firstLoginComplete   Boolean                             @default(false)
  complaints           Complaint[]
  complaintsCreated    Complaint[]                         @relation("ComplaintCreatedBy")
  auditLogs            AuditLog[]
  notifications        Notification[]
  meetingsCreated      Meeting[]                           @relation("MeetingCreatedBy")
  meetingsAssigned     Meeting[]                           @relation("MeetingAssignedTo")
  reviews              Review[]
  disputes             Dispute[]
  officerAssignments   ComplaintOfficerAssignmentHistory[] @relation("OfficerAssignedBy")
  mlaPaMeetingsCreated MlaPaMeeting[]                      @relation("MlaPaMeetingCreatedBy")
  mlaPaMeetingsForMla  MlaPaMeeting[]                      @relation("MlaPaMeetingMla")
  mlaPaMeetingsForCamp MlaPaMeeting[]                      @relation("MlaPaMeetingCampHead")
  createdAt            DateTime                            @default(now())
  updatedAt            DateTime                            @updatedAt
}

model OtpCode {
  id        Int      @id @default(autoincrement())
  mobile    String
  otpHash   String
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([mobile, createdAt])
}

model Complaint {
  id                    Int                                 @id @default(autoincrement())
  userId                String
  user                  User                                @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdByUserId       String?
  createdByUser         User?                               @relation("ComplaintCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  categoryId            Int
  category              Category                            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subcategoryId         Int
  subcategory           Subcategory                         @relation(fields: [subcategoryId], references: [id], onDelete: Restrict)
  description           String                              @db.LongText
  status                ComplaintStatus                     @default(PENDING)
  plannedCompletionDate DateTime?
  lat                   Float
  lng                   Float
  area                  String?
  media                 ComplaintMedia[]
  assignments           Assignment[]
  officerAssignments    ComplaintOfficerAssignmentHistory[]
  auditLogs             AuditLog[]
  reviews               Review[]
  disputes              Dispute[]
  affectedCitizensCount Int                                 @default(1)
  createdAt             DateTime                            @default(now())
  updatedAt             DateTime                            @updatedAt
  complaintClusters     ComplaintCluster[]

  @@index([categoryId, subcategoryId, createdAt])
  @@index([lat, lng])
  @@index([createdByUserId, createdAt])
}

model Review {
  id          Int       @id @default(autoincrement())
  complaintId Int
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating      Int
  review      String    @db.LongText
  photoUrl    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([complaintId, userId])
  @@index([complaintId, createdAt])
  @@index([userId, createdAt])
}

model Dispute {
  id          Int       @id @default(autoincrement())
  complaintId Int
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  remark      String    @db.LongText
  imageUrl    String
  createdAt   DateTime  @default(now())

  @@index([complaintId, createdAt])
  @@index([userId, createdAt])
}

model ComplaintCluster {
  id             Int       @id @default(autoincrement())
  complaintId    Int
  complaint      Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  clusterId      String
  departmentName String
  category       String
  subcategory    String?
  areaKey        String?
  latBucket      Int
  lngBucket      Int
  createdAt      DateTime  @default(now())

  @@index([complaintId])
  @@index([clusterId, createdAt])
  @@index([departmentName, createdAt])
  @@index([departmentName, category, subcategory, latBucket, lngBucket])
}

model ComplaintMedia {
  id          Int       @id @default(autoincrement())
  complaintId Int
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  fileUrl     String
  type        MediaType
  createdAt   DateTime  @default(now())

  @@index([complaintId])
}

model Department {
  id         Int        @id @default(autoincrement())
  name       String     @unique
  officers   Officer[]
  categories Category[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Officer {
  id           Int                                 @id @default(autoincrement())
  name         String
  designation  String
  email        String                              @unique
  phone        String
  departmentId Int
  department   Department                          @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  assignments  Assignment[]
  history      ComplaintOfficerAssignmentHistory[]
  createdAt    DateTime                            @default(now())
  updatedAt    DateTime                            @updatedAt

  @@index([departmentId])
}

model Assignment {
  id            Int                                 @id @default(autoincrement())
  complaintId   Int
  complaint     Complaint                           @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  officerId     Int
  officer       Officer                             @relation(fields: [officerId], references: [id], onDelete: Restrict)
  status        AssignmentStatus                    @default(ASSIGNED)
  dueDate       DateTime
  token         String                              @unique
  responses     Response[]
  notifications Notification[]
  history       ComplaintOfficerAssignmentHistory[]
  createdAt     DateTime                            @default(now())
  updatedAt     DateTime                            @updatedAt

  @@index([complaintId, officerId])
  @@index([status, dueDate])
}

model ComplaintOfficerAssignmentHistory {
  id               Int         @id @default(autoincrement())
  complaintId      Int
  complaint        Complaint   @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  officerId        Int
  officer          Officer     @relation(fields: [officerId], references: [id], onDelete: Restrict)
  assignmentId     Int?
  assignment       Assignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  assignedByUserId String?
  assignedByUser   User?       @relation("OfficerAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)
  isCurrent        Boolean     @default(false)
  createdAt        DateTime    @default(now())

  @@index([complaintId, createdAt])
  @@index([complaintId, isCurrent])
  @@index([officerId, createdAt])
}

model Response {
  id           Int          @id @default(autoincrement())
  assignmentId Int
  assignment   Assignment   @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  type         ResponseType
  message      String       @db.LongText
  proofUrl     String?
  createdAt    DateTime     @default(now())

  @@index([assignmentId, createdAt])
}

model AuditLog {
  id          Int        @id @default(autoincrement())
  actorUserId String?
  actorUser   User?      @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  complaintId Int?
  complaint   Complaint? @relation(fields: [complaintId], references: [id], onDelete: SetNull)
  action      String
  meta        Json?
  createdAt   DateTime   @default(now())

  @@index([complaintId, createdAt])
}

model Notification {
  id           Int                 @id @default(autoincrement())
  userId       String?
  user         User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  assignmentId Int?
  assignment   Assignment?         @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  channel      NotificationChannel
  recipient    String
  message      String
  status       NotificationStatus  @default(SENT)
  error        String?
  createdAt    DateTime            @default(now())

  @@index([userId, createdAt])
  @@index([assignmentId, createdAt])
}

model Meeting {
  id                 Int                   @id @default(autoincrement())
  createdByUserId    String
  createdByUser      User                  @relation("MeetingCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  assignedToUserId   String
  assignedToUser     User                  @relation("MeetingAssignedTo", fields: [assignedToUserId], references: [id], onDelete: Cascade)
  type               MeetingType
  purpose            String                @db.LongText
  meetingDateTime    DateTime?
  meetingPlace       String?
  approvalStatus     MeetingApprovalStatus @default(NOT_REQUIRED)
  approvedAt         DateTime?
  rejectedAt         DateTime?
  completedAt        DateTime?
  approvalRemarks    String?               @db.LongText
  preferredDateTime  DateTime?
  priority           MeetingPriority?
  citizenName        String?
  citizenMobile      String?
  citizenArea        String?
  citizenDetails     String?               @db.LongText
  contactName        String?
  contactMobile      String?
  contactDesignation String?
  contactDepartment  String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([createdByUserId, createdAt])
  @@index([assignedToUserId, createdAt])
  @@index([type, approvalStatus])
  @@index([meetingDateTime])
}

model MlaPaMeeting {
  id                     Int                           @id @default(autoincrement())
  createdByUserId        String
  createdByUser          User                          @relation("MlaPaMeetingCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  mlaUserId              String
  mlaUser                User                          @relation("MlaPaMeetingMla", fields: [mlaUserId], references: [id], onDelete: Restrict)
  campHeadUserId         String
  campHeadUser           User                          @relation("MlaPaMeetingCampHead", fields: [campHeadUserId], references: [id], onDelete: Restrict)
  type                   MlaPaMeetingType
  invitationSubtype      InvitationSubtype?
  invitationOtherPurpose String?                       @db.LongText
  purpose                String                        @db.LongText
  scheduledAt            DateTime
  meetingPlace           String
  completedAt            DateTime?
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt
  invitationDetail       MlaPaMeetingInvitationDetail?

  @@index([createdByUserId, createdAt])
  @@index([mlaUserId, scheduledAt])
  @@index([campHeadUserId, scheduledAt])
  @@index([type, invitationSubtype])
}

model MlaPaMeetingInvitationDetail {
  id                Int          @id @default(autoincrement())
  meetingId         Int          @unique
  meeting           MlaPaMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  giftToCarry       String?      @db.LongText
  selfDraftedLetter String?      @db.LongText
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

model Category {
  id            Int           @id @default(autoincrement())
  name          String
  departmentId  Int
  department    Department    @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  subcategories Subcategory[]
  complaints    Complaint[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([departmentId])
}

model Subcategory {
  id         Int         @id @default(autoincrement())
  name       String
  categoryId Int
  category   Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  complaints Complaint[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}
